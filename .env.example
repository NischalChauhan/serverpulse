
# Application
APP_ENV=development
APP_SECRET_KEY=replace_with_a_secure_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL
POSTGRES_DB=opspulse
POSTGRES_USER=opspulse_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password

# Database connection
DATABASE_URL=postgresql+psycopg://opspulse_user:replace_with_a_strong_database_password@db:5432/opspulse
